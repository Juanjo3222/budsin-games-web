[Unit]
Description=Budsin Pro - suscripciones de PayPal
After=network-online.target
Wants=network-online.target

[Service]
User=budsin-paypal
Group=budsin-paypal
EnvironmentFile=/etc/budsin-paypal.env
ExecStart=/usr/bin/python3 /opt/budsin-paypal/budsin_paypal.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/budsin-paypal

[Install]
WantedBy=multi-user.target
