# Copiado a /etc/budsin-chat.env por install.sh (modo 0640, root:budsin-chat).
CHAT_PORT=3104
CHAT_HOST=127.0.0.1
CHAT_DATA_DIR=/var/lib/budsin-chat
FIREBASE_PROJECT_ID=juanjo-games
# Quién es admin del chat (correo de Google verificado). Los mismos de /admin.html.
CHAT_ADMIN_EMAILS=juvaldiviam@gmail.com,juanjoseguravegamail@gmail.com
# Orígenes que pueden abrir el WebSocket (separados por comas)
CHAT_ORIGINS=https://games.budsin.dev
# Imagenes, stickers y audios (por defecto: CHAT_DATA_DIR/media y el detector en 127.0.0.1:3105)
CHAT_MEDIA_DIR=/var/lib/budsin-chat/media
CHAT_SCAN_URL=http://127.0.0.1:3105
# Probabilidad de "contenido sexual" a partir de la cual se rechaza una imagen (0 a 1; mas bajo = mas estricto)
CHAT_NSFW_THRESHOLD=0.35
# IMAGENES Y STICKERS PROPIOS: apagado por defecto (0). Con 1 se aceptan subidas de imagenes. NO lo actives con menores en el
# sitio sin una defensa real contra material de abuso infantil (CSAM): el detector NSFW incluido NO la sustituye (ver README).
# Notas de voz y stickers predefinidos funcionan siempre.
CHAT_IMAGES=0
