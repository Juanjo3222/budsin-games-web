# Copiado a /etc/budsin-chat.env por install.sh (modo 0640, root:budsin-chat).
CHAT_PORT=3104
CHAT_HOST=127.0.0.1
CHAT_DATA_DIR=/var/lib/budsin-chat
FIREBASE_PROJECT_ID=juanjo-games
# Quién es admin del chat (correo de Google verificado). Los mismos de /admin.html.
CHAT_ADMIN_EMAILS=juvaldiviam@gmail.com,juanjoseguravegamail@gmail.com
# Orígenes que pueden abrir el WebSocket (separados por comas)
CHAT_ORIGINS=https://games.budsin.dev
# Imagenes, stickers y audios (por defecto: CHAT_DATA_DIR/media y el detector en 127.0.0.1:3105)
CHAT_MEDIA_DIR=/var/lib/budsin-chat/media
CHAT_SCAN_URL=http://127.0.0.1:3105
# Probabilidad de "contenido sexual" a partir de la cual se rechaza una imagen (0 a 1; mas bajo = mas estricto)
CHAT_NSFW_THRESHOLD=0.35
# IMAGENES Y STICKERS PROPIOS: apagado por defecto (0). Con 1 se aceptan subidas de imagenes. NO lo actives con menores en el
# sitio sin una defensa real contra material de abuso infantil (CSAM): el detector NSFW incluido NO la sustituye (ver README).
# Notas de voz y stickers predefinidos funcionan siempre.
# Con 1 tambien se activan las FOTOS DE PERFIL propias. Requiere el detector (instalar con WITH_SCAN=1); sin el, las subidas fallan cerradas.
# El usuario ya activo la Cloudflare CSAM Scanning Tool (20-nov-2026): ver README, «Imagenes y fotos de perfil».
CHAT_IMAGES=0
# QUIEN PUEDE ENTRAR: por defecto solo cuentas de Google de colegios y universidades (correo verificado):
#   *.edu , *.edu.?? (ucv.edu.pe, unam.edu.mx...) y *.ac.?? (ox.ac.uk). Los admins entran siempre.
# Para agregar un colegio con dominio propio, ponlo en la lista (acepta sus subdominios) y reinicia: systemctl restart budsin-chat
# Para abrirlo a todos: CHAT_ALLOWED_DOMAINS=*
# No uses comodines que dejen libre la ultima parte (como *.edu.*): cualquiera puede registrar «edu.xyz».
CHAT_ALLOWED_DOMAINS=*.edu,*.edu.??,*.ac.??

# Enlaces permitidos en los mensajes (con sus subdominios; máx. 2 por mensaje). Vacío = ningún enlace.
# Se comprueba el servidor real del enlace (google.com.malo.com NO cuenta) y se rechazan redirecciones (google.com/url?q=…).
CHAT_ALLOWED_LINKS=budsin.dev,google.com,prescott.edu.pe
