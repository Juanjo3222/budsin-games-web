# Copiado a /etc/budsin-music.env por install.sh (modo 0640, root:budsin-music).
MUSIC_PORT=3103
MUSIC_HOST=127.0.0.1
YTM_BASE=https://music.youtube.com
YT_DLP_PATH=/usr/local/bin/yt-dlp
# Límites conservadores: el VPS comparte disco y RAM con el sitio y PayPal
YTM_MAX_CONCURRENT_DOWNLOADS=2
ART_CACHE_MAX_GB=2
YTM_CACHE_MAX_GB=4
ART_CACHE_DIR=/var/lib/budsin-music/art-cache
YTM_CACHE_DIR=/var/lib/budsin-music/ytm-cache

# "DJ Juanjo" (comentarios con IA entre canciones). Sin DJ_API_KEY la función queda apagada y el sitio usa sus plantillas.
# La clave va SOLO aquí (/etc/budsin-music.env, modo 0640): nunca en el repositorio ni en el navegador.
#DJ_API_KEY=
#DJ_API_URL=https://api.dawvq.com
#DJ_MODEL=gpt-6-luna
# Esfuerzo de razonamiento del modelo: low (~5 s) es lo adecuado para estas tareas cortas
#DJ_EFFORT=low
# Tope diario en UNIDADES (UTC): un comentario cuesta 1 y una selección de canciones 4; lo guardado en caché no cuenta.
# Los fallos del proveedor también se cobran: 3 fallos en 5 min pausan el DJ 10 min (la página usa sus plantillas).
#DJ_DAILY_MAX=5000
# Llamadas simultáneas al proveedor
#DJ_MAX_CONCURRENT=4

# Voces del DJ en la nube (opcionales; sin clave esa voz no se ofrece y el DJ usa la del navegador).
# Las claves van SOLO aquí (/etc/budsin-music.env, modo 0640): nunca en el repositorio ni en el navegador.
# Cada voz tiene un tope diario (día UTC): al agotarse, el DJ vuelve a la voz del navegador hasta el día siguiente.
#FISH_API_KEY=
#FISH_MODEL=s2.1-pro-free
# Voz fija de Fish (reference_id de su biblioteca). Por defecto: «Adam», voz masculina de locutor (DJ Juanjo es hombre).
# Evita voces que imitan a personas reales (famosos, personajes): las hay en la biblioteca pública y traen problemas de derechos.
#FISH_VOICE_ID=9deec9a061894a93a133d2bf45d2e4c0
# Tope diario en bytes UTF-8 (una frase de ~100 caracteres son ~105 bytes)
#FISH_DAILY_BYTES=300000
#ELEVENLABS_API_KEY=
#ELEVENLABS_MODEL=eleven_flash_v2_5
# Voz fija. Por defecto: Liam (masculina, enérgica). Otras masculinas premade: Charlie IKne3meq5aSn9XLyUdCD, Roger CwhRBWXzGAHq8TQ4Fs17
#ELEVENLABS_VOICE_ID=TX3LPaxmHKxFdv7VOQHJ
# Tope diario en caracteres (el plan gratis son 10 000 al mes: 3 000 al día lo agotaría en ~3 días; ajústalo a tu plan)
#ELEVENLABS_DAILY_CHARS=3000
