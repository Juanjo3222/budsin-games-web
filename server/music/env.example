# Copiado a /etc/budsin-music.env por install.sh (modo 0640, root:budsin-music).
MUSIC_PORT=3103
MUSIC_HOST=127.0.0.1
YTM_BASE=https://music.youtube.com
YT_DLP_PATH=/usr/local/bin/yt-dlp
# Límites conservadores: el VPS comparte disco y RAM con el sitio y PayPal
YTM_MAX_CONCURRENT_DOWNLOADS=2
ART_CACHE_MAX_GB=2
YTM_CACHE_MAX_GB=4
ART_CACHE_DIR=/var/lib/budsin-music/art-cache
YTM_CACHE_DIR=/var/lib/budsin-music/ytm-cache

# "DJ Juanjo" (comentarios con IA entre canciones). Sin DJ_API_KEY la función queda apagada y el sitio usa sus plantillas.
# La clave va SOLO aquí (/etc/budsin-music.env, modo 0640): nunca en el repositorio ni en el navegador.
#DJ_API_KEY=
#DJ_API_URL=https://api.dawvq.com
#DJ_MODEL=gpt-6-luna
# Tope de llamadas al modelo por día (UTC); lo ya guardado en caché no cuenta
#DJ_DAILY_MAX=2000
