rules_version = '2';

// Reglas PROPUESTAS para el proyecto de Firebase `juanjo-games` (Budsin Games, Budsin Music).
// No se despliegan desde este repositorio: se pegan en Firebase Console > Firestore > Reglas (guarda un historial
// para revertir). Están probadas con el emulador oficial: ver `firestore.rules.test.mjs`.
//
// Sustituyen a `allow read, write: if true`, que deja leer y escribir TODA la base de datos a cualquiera que tenga
// la clave pública del proyecto (está en el JS del sitio): ponerse Pro, borrar guardados ajenos, leer correos...
//
// Colecciones que usa el sitio (inventario hecho leyendo app/src, public/site.js, public/save-system.js y
// public/musica/index.html). Lo que no está aquí queda DENEGADO.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }

    // Los mismos correos que están fijos en el panel de administración (AGENTS.md). Exige correo verificado.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['juvaldiviam@gmail.com', 'juanjoseguravegamail@gmail.com'];
    }

    // Pro vigente según el documento del propio usuario (el cliente de este navegador no es de fiar).
    function isPro() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('pro', false) == true;
    }

    // ---------------------------------------------------------------- usuarios y Pro
    match /users/{uid} {
      allow read: if own(uid) || isAdmin();          // `read` incluye `list`: solo el admin puede listar a todos

      // Al iniciar sesión por primera vez (ensureUserDoc): siempre sin Pro.
      allow create: if own(uid)
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'pro', 'createdAt'])
        && request.resource.data.pro == false
        && request.resource.data.email == request.auth.token.email;

      allow update: if isAdmin()
        || (own(uid) && (
          // 1) Caducidad: el navegador quita el Pro vencido.
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pro', 'trial', 'trialUsed', 'paidUntil'])
            && request.resource.data.pro == false
            && request.resource.data.paidUntil == null
            && request.resource.data.trialUsed == true)
          ||
          // 2) Prueba gratuita de 7 días: una sola vez y no más larga.
          (resource.data.get('trialUsed', false) != true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pro', 'trial', 'trialUsed', 'proSince', 'paidUntil'])
            && request.resource.data.pro == true
            && request.resource.data.trial == true
            && request.resource.data.trialUsed == true
            && request.resource.data.proSince == request.time
            && request.resource.data.paidUntil > request.time
            && request.resource.data.paidUntil <= request.time + duration.value(8, 'd'))
        ));

      allow delete: if false;
    }

    // ---------------------------------------------------------------- popularidad (clics por juego)
    // Cualquiera cuenta una visita: solo sumas de 1 a 5, sin tocar nada más. Lectura pública (el ranking).
    match /game_popularity/{id} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['href', 'name', 'hits', 'updatedAt'])
        && request.resource.data.hits is int
        && request.resource.data.hits >= 1 && request.resource.data.hits <= 5
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.href is string && request.resource.data.href.size() <= 300
        && request.resource.data.updatedAt == request.time;

      allow update: if request.resource.data.keys().hasOnly(['href', 'name', 'hits', 'updatedAt'])
        && request.resource.data.hits is int
        && request.resource.data.hits - resource.data.hits >= 1
        && request.resource.data.hits - resource.data.hits <= 5
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.href == resource.data.href
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // ---------------------------------------------------------------- tablas de puntuaciones (solo Pro envía)
    match /game_leaderboards/{key} {
      allow read: if true;

      allow create, update: if isPro()
        && request.resource.data.keys().hasOnly(['gameName', 'lastScore', 'lastPlayer', 'updatedAt'])
        && request.resource.data.gameName is string && request.resource.data.gameName.size() <= 120
        && request.resource.data.lastScore is number
        && request.resource.data.lastPlayer is string && request.resource.data.lastPlayer.size() <= 40
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();

      match /scores/{scoreId} {
        allow read: if true;
        allow create: if isPro()
          && request.resource.data.keys().hasOnly(['playerName', 'score', 'timestamp'])
          && request.resource.data.score is number
          && request.resource.data.playerName is string && request.resource.data.playerName.size() <= 40
          && request.resource.data.timestamp == request.time;
        allow update, delete: if isAdmin();
      }
    }

    // ---------------------------------------------------------------- solicitudes de juegos
    match /game_requests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['gameName', 'gameUrl', 'description', 'uid', 'email', 'status', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.gameName is string && request.resource.data.gameName.size() <= 120
        && request.resource.data.gameUrl is string && request.resource.data.gameUrl.size() <= 300
        && request.resource.data.description is string && request.resource.data.description.size() <= 1000
        && (request.resource.data.uid == 'anonymous' || own(request.resource.data.uid))
        && request.resource.data.createdAt == request.time;

      allow read, update, delete: if isAdmin();     // el panel de administración
    }

    // ---------------------------------------------------------------- guardado en la nube de los juegos
    // El id del documento es `{uid}_{juego}`: solo su dueño. Lo mismo para los fragmentos (`chunks`).
    match /gamesaves/{saveId} {
      allow read, write: if signedIn() && saveId.matches(request.auth.uid + '_.*');

      match /chunks/{chunkId} {
        allow read, write: if signedIn() && saveId.matches(request.auth.uid + '_.*');
      }
    }

    // ---------------------------------------------------------------- Budsin Music: perfil sincronizado
    match /music_profiles/{uid}/{document=**} {
      allow read, write: if own(uid);
    }

    // Todo lo demás queda denegado.
  }
}
